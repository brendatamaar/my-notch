<UserControl x:Class="MyNotch.Controls.SettingsControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <Style x:Key="SectionLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="CharacterSpacing" Value="80" />
      <Setter Property="Foreground" Value="{StaticResource NotchText3Brush}" />
      <Setter Property="Margin" Value="0,4,0,0" />
    </Style>
    <Style x:Key="SettingCheck" TargetType="CheckBox">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="Padding" Value="6,0,0,0" />
    </Style>
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
    <Grid ColumnSpacing="22">
      <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
      <StackPanel Spacing="3">
        <TextBlock Text="GENERAL" Style="{StaticResource SectionLabel}" />
        <CheckBox x:Name="StartupBox" Content="Start with Windows" Style="{StaticResource SettingCheck}" Click="Startup_Click" />
        <CheckBox x:Name="FullscreenBox" Content="Hide while an app is fullscreen" Style="{StaticResource SettingCheck}" Click="Fullscreen_Click" />
        <Grid ColumnSpacing="8">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
          <TextBlock Text="Show on" FontSize="12" VerticalAlignment="Center" Foreground="{StaticResource NotchText2Brush}" />
          <Button x:Name="DisplayButton" Grid.Column="1" Style="{StaticResource NotchButtonStyle}" Padding="10,4" FontSize="11" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" AutomationProperties.Name="Display for the notch">
            <Button.Flyout><MenuFlyout x:Name="DisplayMenu" Opening="DisplayMenu_Opening" /></Button.Flyout>
          </Button>
        </Grid>
        <TextBlock Text="FOCUS (MINUTES)" Style="{StaticResource SectionLabel}" />
        <StackPanel x:Name="FocusSteppers" Spacing="3" />
        <TextBlock Text="WELLNESS (MINUTES)" Style="{StaticResource SectionLabel}" />
        <StackPanel x:Name="WellnessSteppers" Spacing="3" />
        <TextBlock Text="CALENDAR" Style="{StaticResource SectionLabel}" />
        <Grid ColumnSpacing="5">
          <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <TextBox x:Name="FeedBox" PlaceholderText="Secret iCal address (https:// or webcal://)" FontSize="11" Height="28" MinHeight="28" Padding="7,3" CornerRadius="8" AutomationProperties.Name="Calendar feed address" />
          <Button Grid.Column="1" Content="Save" Click="SaveFeed_Click" Style="{StaticResource NotchButtonStyle}" Padding="10,3" FontSize="11" Height="28" />
        </Grid>
        <StackPanel x:Name="LeadHost" />
        <TextBlock x:Name="CalendarStatus" FontSize="10" Foreground="{StaticResource NotchText3Brush}" TextWrapping="Wrap" MaxLines="2" />
      </StackPanel>
      <StackPanel Grid.Column="1" Spacing="3">
        <TextBlock Text="AGENTS" Style="{StaticResource SectionLabel}" />
        <CheckBox x:Name="ApprovalsBox" Content="Answer Claude Code permission prompts here" Style="{StaticResource SettingCheck}" Click="Approvals_Click" />
        <StackPanel x:Name="ApprovalWaitHost" />
        <Button Content="Copy Claude Code hooks" Click="CopyHooks_Click" Style="{StaticResource NotchButtonStyle}" Padding="10,4" FontSize="11" HorizontalAlignment="Left" ToolTipService.ToolTip="Copies the settings.json hooks block; paste it into ~/.claude/settings.json" />
        <TextBlock Text="DEVELOPER" Style="{StaticResource SectionLabel}" />
        <CheckBox x:Name="ClipsBox" Content="Keep the last 10 copied texts (memory only)" Style="{StaticResource SettingCheck}" Click="Clips_Click" />
        <CheckBox x:Name="CiBox" Content="Notify when a running CI build finishes" Style="{StaticResource SettingCheck}" Click="Ci_Click" />
        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
          <Button Content="Notification settings" Click="Notifications_Click" Style="{StaticResource NotchButtonStyle}" Padding="10,4" FontSize="11" />
          <Button Content="Open settings folder" Click="OpenFolder_Click" Style="{StaticResource NotchButtonStyle}" Padding="10,4" FontSize="11" />
        </StackPanel>
        <TextBlock x:Name="SettingsStatus" FontSize="10" Foreground="#FFBF70" TextWrapping="Wrap" MaxLines="3" />
      </StackPanel>
    </Grid>
  </ScrollViewer>
</UserControl>
