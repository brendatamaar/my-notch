<UserControl
    x:Class="MyNotch.Controls.AgentAlertControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource NotchCardStyle}"
            PointerPressed="Alert_PointerPressed" Tapped="Alert_Tapped">
        <StackPanel Spacing="6">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="{StaticResource NotchGrayBrush}"
                         VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.AgentName, Mode=OneWay}"
                           Foreground="{StaticResource NotchText1Brush}" FontSize="14" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" x:Name="StatusLabel"
                           Foreground="{StaticResource NotchText2Brush}" FontSize="11" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </Grid>
            <TextBlock Text="{x:Bind ViewModel.Message, Mode=OneWay}"
                       Foreground="{StaticResource NotchText1Brush}" Opacity="0.85"
                       FontSize="12" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="Click to focus the sender"
                       Foreground="{StaticResource NotchText3Brush}" FontSize="10" />
        </StackPanel>
    </Border>
</UserControl>
