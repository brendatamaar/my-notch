<UserControl x:Class="MyNotch.Controls.SystemUsageControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid RowSpacing="11">
    <Grid.RowDefinitions><RowDefinition Height="44" /><RowDefinition /></Grid.RowDefinitions>
    <Grid x:Name="ModuleStrip" ColumnSpacing="5" />
    <Grid Grid.Row="1" ColumnSpacing="14">
      <Grid.ColumnDefinitions><ColumnDefinition Width="145" /><ColumnDefinition /><ColumnDefinition Width="157" /></Grid.ColumnDefinitions>
      <StackPanel Spacing="5">
        <TextBlock x:Name="ModuleTitle" Text="CPU" FontSize="12" FontWeight="SemiBold" Foreground="White" />
        <Grid Width="76" Height="76" HorizontalAlignment="Center" Margin="0,1">
          <Ellipse x:Name="RingTrack" Stroke="#24262C" StrokeThickness="6" />
          <Ellipse x:Name="Ring" Stroke="#69ADFF" StrokeThickness="6" StrokeDashArray="0,100" RenderTransformOrigin="0.5,0.5"><Ellipse.RenderTransform><RotateTransform Angle="-90" /></Ellipse.RenderTransform></Ellipse>
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="1">
            <TextBlock x:Name="MainValue" Text="--" FontSize="20" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" />
            <TextBlock x:Name="MainCaption" Text="total load" FontSize="9" Foreground="#8F939E" HorizontalAlignment="Center" />
          </StackPanel>
        </Grid>
        <StackPanel x:Name="DetailsHost" Spacing="4" />
      </StackPanel>
      <StackPanel Grid.Column="1" Spacing="5">
        <Grid><TextBlock Text="USAGE HISTORY" FontSize="9" CharacterSpacing="70" Foreground="#8F939E" /><TextBlock x:Name="ChartScale" FontSize="9" Foreground="#646974" HorizontalAlignment="Right" /></Grid>
        <Canvas x:Name="HistoryChart" Height="70" SizeChanged="Chart_SizeChanged" />
        <TextBlock Text="Last minute while open" FontSize="9" Foreground="#646974" />
        <TextBlock x:Name="SecondaryTitle" Text="USER / SYSTEM" FontSize="9" CharacterSpacing="70" Foreground="#8F939E" Margin="0,5,0,0" />
        <Canvas x:Name="SecondaryChart" Height="48" SizeChanged="Chart_SizeChanged" />
        <TextBlock x:Name="SourceLabel" FontSize="9" Foreground="#646974" MaxLines="2" TextWrapping="Wrap" />
      </StackPanel>
      <StackPanel Grid.Column="2" Spacing="6">
        <TextBlock x:Name="ListTitle" Text="TOP PROCESSES" FontSize="9" CharacterSpacing="70" Foreground="#8F939E" />
        <StackPanel x:Name="ListHost" Spacing="7" />
        <Grid x:Name="ListPager" Visibility="Collapsed"><Button x:Name="PreviousList" Content="&#x2039;" Click="PreviousList_Click" Style="{StaticResource NotchButtonStyle}" Padding="7,0" Height="20" MinHeight="20" /><TextBlock x:Name="ListPageLabel" FontSize="9" Foreground="#646974" HorizontalAlignment="Center" VerticalAlignment="Center" /><Button x:Name="NextList" Content="&#x203A;" Click="NextList_Click" Style="{StaticResource NotchButtonStyle}" Padding="7,0" Height="20" MinHeight="20" HorizontalAlignment="Right" /></Grid>
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
