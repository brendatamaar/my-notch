<UserControl x:Class="MyNotch.Controls.UsageCardControl"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border Background="#141414" CornerRadius="15" Padding="11,9">
    <StackPanel Spacing="7">
      <Grid ColumnSpacing="7">
        <Grid.ColumnDefinitions><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <Viewbox Width="16" Height="16" VerticalAlignment="Center"><Canvas Width="24" Height="24">
          <Path x:Name="CodexIcon" Data="M8,5 L2,12 L8,19 M16,5 L22,12 L16,19 M14,3 L10,21" Visibility="Collapsed" Stroke="#E9E9E9" StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
          <Path x:Name="ClaudeIcon" Data="M12,2 L12,22 M2,12 L22,12 M5,5 L19,19 M5,19 L19,5 M8,3 L16,21 M3,8 L21,16 M3,16 L21,8 M8,21 L16,3" Visibility="Collapsed" Stroke="#E9E9E9" StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
          <Path x:Name="AntigravityIcon" Data="M3,21 L12,3 L21,21 M7,15 L17,15 M9,21 L12,15 L15,21" Visibility="Collapsed" Stroke="#E9E9E9" StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
          <Path x:Name="MuseIcon" Data="M2,16 C4,2 8,2 12,12 C16,22 20,22 22,8 M2,16 C6,24 8,17 12,12 C16,7 18,0 22,8" Visibility="Collapsed" Stroke="#E9E9E9" StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
        </Canvas></Viewbox>
        <TextBlock x:Name="ServiceName" Grid.Column="1" FontSize="12" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" />
        <TextBlock x:Name="PlanLabel" Grid.Column="2" FontSize="10" Foreground="#989898" VerticalAlignment="Center" MaxWidth="64" TextTrimming="CharacterEllipsis" />
      </Grid>
      <StackPanel x:Name="WindowsHost" Spacing="6" />
      <Button x:Name="ResetLimitButton" Content="Reset limit" Click="ResetLimit_Click" Style="{StaticResource NotchButtonStyle}" Padding="8,3" FontSize="10" Visibility="Collapsed" ToolTipService.ToolTip="Uses one reset credit provided by your account" />
      <TextBlock x:Name="StatusLabel" FontSize="10" Foreground="#989898" TextWrapping="Wrap" />
    </StackPanel>
  </Border>
</UserControl>
