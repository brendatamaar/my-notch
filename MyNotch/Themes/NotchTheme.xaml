<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Text inputs: flat dark field, white focus line -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="TextControlBackground" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#1FFFFFFF" />
            <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="TextControlForeground" Color="#FFF4F4F5" />
            <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#FFF4F4F5" />
            <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#FF62626A" />
            <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#FF62626A" />
            <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#FF62626A" />
            <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="#60FFFFFF" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>


    <!-- Colours follow Oyenza Studio's design/tokens.json (dark "editor" palette + site orange). -->
    <Color x:Key="NotchBlack">#FF000000</Color>
    <Color x:Key="NotchAccent">#FFFFFFFF</Color>
    <Color x:Key="NotchBlue">#FF0A84FF</Color>
    <Color x:Key="NotchGreen">#FF30D158</Color>
    <Color x:Key="NotchRed">#FFE5484D</Color>
    <Color x:Key="NotchAmber">#FFFFCA16</Color>

    <SolidColorBrush x:Key="NotchBlackBrush" Color="{StaticResource NotchBlack}" />
    <SolidColorBrush x:Key="NotchAccentBrush" Color="{StaticResource NotchAccent}" />
    <SolidColorBrush x:Key="NotchBlueBrush" Color="{StaticResource NotchBlue}" />
    <SolidColorBrush x:Key="NotchGreenBrush" Color="{StaticResource NotchGreen}" />
    <SolidColorBrush x:Key="NotchRedBrush" Color="{StaticResource NotchRed}" />
    <SolidColorBrush x:Key="NotchAmberBrush" Color="{StaticResource NotchAmber}" />
    <SolidColorBrush x:Key="NotchGrayBrush" Color="#FF8E8E93" />

    <!-- ctl / ctl-hover / ctl-active / line from the dark editor palette -->
    <SolidColorBrush x:Key="NotchSurfaceBrush" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="NotchSurfaceHoverBrush" Color="#17FFFFFF" />
    <SolidColorBrush x:Key="NotchSurfaceActiveBrush" Color="#21FFFFFF" />
    <SolidColorBrush x:Key="NotchLineBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="NotchText1Brush" Color="#FFF4F4F5" />
    <SolidColorBrush x:Key="NotchText2Brush" Color="#FF9A9AA3" />
    <SolidColorBrush x:Key="NotchText3Brush" Color="#FF62626A" />
    <SolidColorBrush x:Key="NotchDangerFillBrush" Color="#2BE5484D" />
    <SolidColorBrush x:Key="NotchDangerTextBrush" Color="#FFFF9592" />

    <!-- Base button: rounded surface with a hover/press overlay, so accent and danger variants only change colours. -->
    <Style x:Key="NotchButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource NotchSurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource NotchText1Brush}" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root">
                        <Border x:Name="Fill" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" />
                        <Border x:Name="Overlay" Background="#22FFFFFF" CornerRadius="{TemplateBinding CornerRadius}" Opacity="0" />
                        <ContentPresenter x:Name="Presenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Foreground="{TemplateBinding Foreground}"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Overlay.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Overlay.Opacity" Value="1" />
                                        <Setter Target="Root.Opacity" Value="0.8" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NotchAccentButtonStyle" TargetType="Button" BasedOn="{StaticResource NotchButtonStyle}">
        <Setter Property="Background" Value="{StaticResource NotchAccentBrush}" />
        <Setter Property="Foreground" Value="{StaticResource NotchBlackBrush}" />
    </Style>

    <Style x:Key="NotchDangerButtonStyle" TargetType="Button" BasedOn="{StaticResource NotchButtonStyle}">
        <Setter Property="Background" Value="{StaticResource NotchDangerFillBrush}" />
        <Setter Property="Foreground" Value="{StaticResource NotchDangerTextBrush}" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="CornerRadius" Value="11" />
    </Style>

    <!-- Round icon button (media controls, refresh) -->
    <Style x:Key="NotchIconButtonStyle" TargetType="Button" BasedOn="{StaticResource NotchButtonStyle}">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style x:Key="NotchPlayButtonStyle" TargetType="Button" BasedOn="{StaticResource NotchAccentButtonStyle}">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="23" />
    </Style>

    <!-- Tab strip item -->
    <Style x:Key="NotchTabStyle" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource NotchText2Brush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="7,0" />
        <Setter Property="MinWidth" Value="28" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid x:Name="Root">
                        <Border x:Name="Fill" Background="Transparent" CornerRadius="18" />
                        <ContentPresenter x:Name="Presenter"
                                          Content="{TemplateBinding Content}"
                                          Foreground="{TemplateBinding Foreground}"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalContentAlignment="Center"
                                          VerticalContentAlignment="Center" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Fill.Background" Value="{StaticResource NotchSurfaceBrush}" />
                                        <Setter Target="Presenter.Foreground" Value="{StaticResource NotchText1Brush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Fill.Background" Value="{StaticResource NotchSurfaceHoverBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled" />
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Unchecked" />
                                <VisualState x:Name="Indeterminate" />
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="Fill.Background" Value="{StaticResource NotchSurfaceActiveBrush}" />
                                        <Setter Target="Presenter.Foreground" Value="White" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NotchCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource NotchSurfaceBrush}" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="12,10" />
    </Style>
</ResourceDictionary>

